# ── 複製為 .env 後填入實際值 ──

# PostgreSQL（docker compose 用）
POSTGRES_USER=bus
POSTGRES_PASSWORD=請改成高強度密碼
POSTGRES_DB=fsshbus

# Next.js 後端連線（容器內以服務名稱連線；本機開發改用 localhost）
DATABASE_URL=postgresql://bus:請改成高強度密碼@db:5432/fsshbus
REDIS_URL=redis://redis:6379

# JWT 簽章密鑰（30 分鐘過期）；請用亂數產生，例如：openssl rand -base64 48
JWT_SECRET=請改成隨機密鑰

# Google OAuth 2.0（GCP Console → 憑證 → OAuth 用戶端 ID，類型選「網頁應用程式」）
# 「已授權的 JavaScript 來源」需加入 https://bus.fssh.khc.edu.tw 與 http://localhost:1135
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# 僅允許此網域的 Google 帳號登入
ALLOWED_EMAIL_DOMAIN=fssh.khc.edu.tw

# 管理員信箱（逗號分隔），登入時自動賦予管理員權限
ADMIN_EMAILS=admin@fssh.khc.edu.tw
