{
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "Dockerfile": "docker-compose.*, .dockerignore",
        "package.json": "package-lock.json",
    },
    "files.exclude": {
        "package.json": true,

        ".next": true,
        ".claude": true,
        "node_modules": true,
        "scripts": true,
        "data": true,
        "public": true,

        "Dockerfile": true,
        
        "next.config.ts": true,
        "next-env.d.ts": true,
        "tsconfig.json": true,
        "tsconfig.tsbuildinfo": true,
        "eslint.config.mjs": true,
        "postcss.config.mjs": true,

        "schema.prisma": true,
        "prisma.config.ts": true,
        
        "nginx.conf": true,
        
        ".gitignore": true,

        ".env": true,
        ".env.example": true,

        
        "app/(student)": true,
        "app/admin": true,
        "app/login": true,
        "app/globals.css": true,
        "app/layout.tsx": true,
        "app/not-found.tsx": true,
        "components": true,
        "hooks": true,
        "services": true,
    }
}