{
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "Dockerfile": "docker-compose.*, .dockerignore",
        "package.json": "package-lock.json",
    },
    "files.exclude": {
        "package.json": true,

        ".next": true,
        ".claude": true,
        "node_modules": true,
        "data": true,
        "public": true,

        "server": true,
        "scripts": true,

        "Dockerfile": false,
        
        "next-env.d.ts": true,
        "tsconfig.json": true,
        "tsconfig.tsbuildinfo": true,
        "eslint.config.mjs": true,
        "postcss.config.mjs": true,
        "next.config.ts": true,

        "README.md": true,

        "schema.prisma": true,
        "prisma.config.ts": true,
        
        
        ".gitignore": true,

        ".env*": true,

    }
}